    <!-- Onboarding -->
    <string name="onb_welcome_title">Il tuo tempo di utilizzo, solo sul tuo telefono</string>
    <string name="onb_welcome_body">Questa app registra quanto usi il telefono e ogni app. Tutto resta su questo dispositivo: nessun account, nessuna pubblicità e l’app non ha il permesso di accedere a internet.</string>
    <string name="onb_usage_title">Consenti l’accesso all’utilizzo</string>
    <string name="onb_usage_body">Android tiene un registro di quale app è in primo piano. Per leggerlo, cerca “Screen Time” nell’elenco che si apre e attivalo.</string>
    <string name="onb_usage_action">Apri le impostazioni di accesso all’utilizzo</string>
    <string name="onb_usage_granted">Accesso all’utilizzo attivo</string>
    <string name="onb_battery_title">Mantienila attiva</string>
    <string name="onb_battery_body">L’app legge il registro di Android solo ogni poche ore, con un consumo di batteria quasi nullo. Alcuni telefoni bloccano troppo i processi in background, quindi conviene escludere questa app.</string>
    <string name="onb_battery_status_on">Restrizione batteria: disattivata (bene)</string>
    <string name="onb_battery_status_off">Restrizione batteria: attiva</string>
    <string name="onb_battery_action">Consenti uso in background senza restrizioni</string>
    <string name="onb_battery_app_settings">Apri le impostazioni dell’app</string>
    <string name="onb_battery_tips_realme">Su realme / Oppo / OnePlus: apri le impostazioni dell’app, poi Batteria, e consenti attività in background e avvio automatico. Blocca anche l’app nell’elenco delle app recenti.</string>
    <string name="onb_battery_tips_xiaomi">Su Xiaomi / Redmi / Poco: apri le impostazioni dell’app, imposta Risparmio batteria su Nessuna restrizione e attiva Avvio automatico.</string>
    <string name="onb_battery_tips_samsung">Su Samsung: apri le impostazioni della batteria, poi Limiti di utilizzo in background, e verifica che l’app non sia negli elenchi delle app in stop.</string>
    <string name="onb_battery_tips_generic">Se il telefono ha un gestore batteria aggiuntivo, imposta questa app su senza restrizioni e consentile l’avvio automatico.</string>
