    <!-- Onboarding -->
    <string name="onb_welcome_title">Your screen time, on your phone only</string>
    <string name="onb_welcome_body">This app records how long you use your phone and each app. Everything stays on this device: there are no accounts, no ads and the app has no internet permission.</string>
    <string name="onb_usage_title">Allow usage access</string>
    <string name="onb_usage_body">Android keeps a log of which app is on screen. To read it, find “Screen Time” in the list that opens and turn it on.</string>
    <string name="onb_usage_action">Open usage access settings</string>
    <string name="onb_usage_granted">Usage access is on</string>
    <string name="onb_battery_title">Keep it running</string>
    <string name="onb_battery_body">The app only reads Android’s log every few hours, which uses almost no battery. Some phones stop background work too aggressively, so it helps to exempt this app.</string>
    <string name="onb_battery_status_on">Battery restriction: off (good)</string>
    <string name="onb_battery_status_off">Battery restriction: on</string>
    <string name="onb_battery_action">Allow unrestricted background use</string>
    <string name="onb_battery_app_settings">Open app settings</string>
    <string name="onb_battery_tips_realme">On realme / Oppo / OnePlus: open the app settings, then Battery, and allow background activity and auto launch. Also lock the app in the recent apps list.</string>
    <string name="onb_battery_tips_xiaomi">On Xiaomi / Redmi / Poco: open the app settings, set Battery saver to No restrictions and turn on Autostart.</string>
    <string name="onb_battery_tips_samsung">On Samsung: open Battery settings, then Background usage limits, and make sure this app is not in the sleeping or deep sleeping lists.</string>
    <string name="onb_battery_tips_generic">If your phone has an extra battery manager, set this app to unrestricted and allow it to start automatically.</string>
